{
  "name": "dsh-llm-adapters",
  "displayName": "Local LLM Adapters",
  "description": "DeepSeek Harness adapters for Loomy and SenseTime Raccoon. Reuses the desktop apps' local login state, exposes their model catalogs, quota, and per-model settings pages without asking for an API key.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "k1-h2",
  "keywords": [
    "dsh-plugin",
    "dsh-llm-adapters",
    "deepseek-harness",
    "loomy",
    "iflytek",
    "raccoon",
    "sensenova",
    "xiaohuanxiong",
    "openai-compatible",
    "model-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1-h2/dsh-llm-adapters.git"
  },
  "homepage": "https://github.com/k1-h2/dsh-llm-adapters#readme",
  "bugs": {
    "url": "https://github.com/k1-h2/dsh-llm-adapters/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "*",
    "@deepseek-ai/dsh-attachment": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly",
    "test": "vitest run",
    "prepublishOnly": "npm run build:clean && npm test"
  }
}
